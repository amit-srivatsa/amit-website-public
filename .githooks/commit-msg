#!/bin/sh
# Rejects commit messages that do not start with a version, e.g. "v1.0: fix footer link".
# Enable with: git config core.hooksPath .githooks

first_line=$(grep -v '^#' "$1" | head -n 1)

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^v[0-9]+\.[0-9]+: .+'; then
  echo "Commit message must start with a version, e.g. \"v1.0: fix footer link\"." >&2
  echo "See CONTRIBUTING.md for the numbering rules." >&2
  exit 1
fi
